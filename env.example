# On-prem environment template.
# Copy to .env and fill in your own values. Do not commit .env.
#   cp env.example .env

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# JWT signing secret (min 32 chars). Generate with: openssl rand -base64 32
# Set the same value as secret_key in config/gateway.yaml.
JWT_SECRET=

# Chat provider key. Any LiteLLM provider. The model id is set in
# litellm/config.standalone.yaml as provider/model-id.
LLM_API_KEY=

# LiteLLM proxy key. llm-service sends this bearer token to LiteLLM.
# This is a local proxy secret, not a provider key. Change it before sharing the host.
LITELLM_MASTER_KEY=sk-litellm-local

# Prompt family used by the application. This does not select the cloud provider.
LLM_TYPE=openai

# Standalone UI is served at /, over local HTTP.
REDIRECT_URL=/
HTTPS=False

# -----------------------------------------------------------------------------
# Optional — multimodal provider key. Any LiteLLM provider that accepts images.
# Leave empty to skip image and document understanding.
# Set the model id in litellm/config.standalone.yaml as provider/model-id.
# -----------------------------------------------------------------------------

MULTIMODAL_API_KEY=

# -----------------------------------------------------------------------------
# Optional — Google login (skip for Keycloak username/password)
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/v1/auth/oauth/google/callback

# -----------------------------------------------------------------------------
# ContextForge (Admin UI: http://localhost:4444/admin)
# Generate the two secrets with: openssl rand -base64 32
# Create CONTEXTFORGE_SERVICE_TOKEN in the ContextForge admin UI after first login.
# -----------------------------------------------------------------------------

CONTEXTFORGE_ADMIN_EMAIL=admin@aiqualitica.local
CONTEXTFORGE_ADMIN_PASSWORD=ChangeMe1!
CONTEXTFORGE_JWT_SECRET_KEY=
AUTH_ENCRYPTION_SECRET=
CONTEXTFORGE_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# Keycloak admin (console: http://localhost:8090/admin)
# Change these before exposing the host beyond your machine.
# -----------------------------------------------------------------------------

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Local infrastructure defaults
# -----------------------------------------------------------------------------

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
NEO4J_PASSWORD=password
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
