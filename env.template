# API token used by TCM / requirement / document-preprocessor (A2A register + MCP admin)
CONTEXTFORGE_SERVICE_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..WG_kFFP40PBBA3H84kHqsunUz7cAj7kbHqJvP7pkkE4

