# TestCase Generation Platform - Environment Configuration
# Copy to .env:  cp env.template .env
# Then fill in the values below.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# JWT signing secret (min 32 chars). Generate with: openssl rand -base64 32
# If you change this, also update secret_key in config/gateway.yaml
JWT_SECRET=your_jwt_secret_here

# LLM provider (defaults = OpenAI). Full options: ../llm-service/README.md
#
# Pick one profile and set LLM_API_KEY for that provider:
#
#   OpenAI:     LLM_TYPE=openai     LLM_DEPLOYMENT_TYPE=api         LLM_MODEL_PATH=gpt-4.1
#   Anthropic:  LLM_TYPE=anthropic  LLM_DEPLOYMENT_TYPE=api         LLM_MODEL_PATH=claude-sonnet-4-20250514
#   Gemini:     LLM_TYPE=gemini     LLM_DEPLOYMENT_TYPE=api         LLM_MODEL_PATH=gemini-2.0-flash
#   Together:   LLM_TYPE=deepseek_v3 LLM_DEPLOYMENT_TYPE=togetherai LLM_MODEL_PATH=deepseek-ai/DeepSeek-V2.5
#
LLM_API_KEY=your_llm_api_key_here
LLM_TYPE=openai
LLM_DEPLOYMENT_TYPE=api
LLM_MODEL_PATH=gpt-4.1

# -----------------------------------------------------------------------------
# Optional — Google login only (skip if using Keycloak username/password)
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
