# TestCase Generation Platform - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# MANDATORY FIELDS - These must be configured for the platform to work
# =============================================================================

# JWT Secret (Required)
# Generate a secure random string for JWT token signing
# You can generate one with: openssl rand -base64 32
# Or use any secure random string (minimum 32 characters)
JWT_SECRET=your_jwt_secret_here
# If you change JWT_SECRET, also update secret_key in config/gateway.yaml

# LLM API Key (Required for LLM features)
# Supported cloud API providers:
#   - OpenAI (default): LLM_DEPLOYMENT_TYPE=api, LLM_TYPE=openai
#     Get key from: https://platform.openai.com/
#   - Together AI: LLM_DEPLOYMENT_TYPE=togetherai, LLM_TYPE=deepseek_v3|mistral|tinyllama|deepseek_coder|codellama|mixtral_8x7b_instruct|qwen
#     Get key from: https://api.together.xyz/
# Planned (not implemented): gemini, anthropic
# Compose defaults: LLM_TYPE=openai, LLM_DEPLOYMENT_TYPE=api, LLM_MODEL_PATH=gpt-4.1
LLM_API_KEY=your_openai_api_key_here
# Optional overrides (uncomment to change provider/model):
# LLM_TYPE=openai
# LLM_DEPLOYMENT_TYPE=api
# LLM_MODEL_PATH=gpt-4.1

# =============================================================================
# OPTIONAL FIELDS - These have sensible defaults and can be left as-is
# =============================================================================

# Google OAuth Configuration (Optional)
# Only required for Google-based login / Google Identity Provider in Keycloak.
# Keycloak-only authentication (username/password or other Keycloak IdPs) works
# without these. If omitted, keycloak-one-time-setup skips Google IdP configuration.
# Get these from: https://console.cloud.google.com/
# 1. Go to Google Cloud Console
# 2. Create a new project or select existing
# 3. Enable Google+ API
# 4. Create OAuth 2.0 credentials
# 5. Add authorized redirect URI: http://localhost/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# All other configuration uses sensible defaults for local development
# No additional configuration required for basic functionality
