CONTEXTFORGE_ADMIN_EMAIL=admin@aiqualitica.local
CONTEXTFORGE_ADMIN_PASSWORD=ChangeMe1!
# Signs ContextForge API JWTs (must match token issuer secret used for CONTEXTFORGE_SERVICE_TOKEN)
CONTEXTFORGE_JWT_SECRET_KEY=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
